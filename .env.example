# ── Base URLs (per environment) ───────────────────────────────────────────────
# One set of sources deploys to every environment by setting these before build.
#   dev      *.valyd.work  (defaults — used if unset)
#   testing  *.valyd.vip
#   prod     *.valyd.id
# scripts/gen-corpus.mjs (prebuild) rewrites the AI-agent corpus (llms.txt,
# .md mirrors, OpenAPI, robots) to these hosts; lib/site.ts uses them for the
# sitemap and canonical links.
NEXT_PUBLIC_DOCS_URL=https://docs.valyd.work
NEXT_PUBLIC_IDP_URL=https://idp.valyd.work
NEXT_PUBLIC_DEV_URL=https://dev.valyd.work
NEXT_PUBLIC_MCP_URL=https://mcp.valyd.work

# ── Ask AI chat widget (app/api/chat) ─────────────────────────────────────────
# The widget proxies to the Valyd Docs Agent (RAG over the docs, streaming SSE).
# Point this at the docs-agent for the target environment.
#   dev  https://docs-agent.valyd.work   (default if unset)
DOCS_AGENT_URL=https://docs-agent.valyd.work

# Optional rate-limit tuning for the /api/chat proxy (per server IP).
# CHAT_RATE_MAX=20
# CHAT_RATE_WINDOW_MS=60000
