# KEY=value (no spaces around =)

# --- Login with Valyd (OIDC) — from your project in the Valyd dev portal ---
VALYD_CLIENT_ID=your_client_id_here
VALYD_CLIENT_SECRET=your_client_secret_here
VALYD_REDIRECT_URI=http://localhost:8080/callback

# Optional: override the IdP origin for sandbox testing
# VALYD_BASE_URL=https://idp.valyd.work

# --- Optional: test a verification workflow after login ---
# Set BOTH to show a "Test verification workflow" button on the signed-in page.
# Get the API key from your project's Verification tab, and a workflow id from its workflows.
VALYD_VERIFY_API_KEY=
VALYD_WORKFLOW_ID=
# Optional: override the Verify API base (defaults to <VALYD_BASE_URL>/api/v2)
# VALYD_VERIFY_BASE_URL=https://idp.valyd.work/api/v2

# App
PORT=8080
NODE_ENV=development
