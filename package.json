{
  "name": "valyd-docs",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/gen-corpus.mjs && next dev",
    "gen-corpus": "node scripts/gen-corpus.mjs",
    "prebuild": "node scripts/gen-corpus.mjs",
    "build": "next build --webpack",
    "postbuild": "node scripts/rewrite-built-hosts.mjs && node scripts/check-hosts.mjs && pagefind --site .next/server/app --output-path public/_pagefind",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "check-links": "node scripts/check-links.mjs && node scripts/check-product-boundaries.mjs"
  },
  "dependencies": {
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-tooltip": "^1.2.16",
    "dompurify": "^3.4.13",
    "lucide-react": "^1.28.0",
    "mermaid": "^11.16.1",
    "next": "^16.3.1",
    "nextra": "^4.6.1",
    "nextra-theme-docs": "^4.6.1",
    "openai": "^4.77.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "overrides": {
    "nextra": {
      "zod": "4.1.12"
    },
    "nextra-theme-docs": {
      "zod": "4.1.12"
    }
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.16.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.32.0",
    "eslint-config-next": "^16.2.12",
    "pagefind": "^1.3.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.8.3"
  }
}
